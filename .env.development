# ============================================================================
# AI Presentation Avatar SaaS - Development Environment Configuration
# ============================================================================
# Copy from env.example and fill in YOUR actual credentials below

# Backend Server
BACKEND_URL=http://localhost:8000
ENVIRONMENT=development

# Database - Local PostgreSQL
DATABASE_URL=postgresql+asyncpg://user:password@localhost/presentation_saas_db
DB_HOST=localhost
DB_SOCKET=
DB_NAME=presentation_saas_db
DB_USER=user
DB_PASSWORD=change-me

# Authentication & Security
SECRET_KEY=dev-secret-key-change-in-production-12345678
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OAuth - Google (optional for development)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback/google

# Auth storage
AUTH_DATABASE_URL=
ADMIN_EMAIL=admin@example.com
VERIFICATION_CODE_EXPIRE_MINUTES=10

# ============================================================================
# SMTP - Email Verification (REQUIRED for user registration)
# ============================================================================
# Gmail Setup Instructions:
#   1. Enable 2FA: https://myaccount.google.com/security
#   2. Create App Password: https://myaccount.google.com/apppasswords
#   3. Use the 16-character app password below (NOT your Google password)
#
# Example for Gmail:
#   SMTP_USERNAME=your-email@gmail.com
#   SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
#
# For other providers (Outlook, SendGrid, etc.), check their SMTP docs
# ============================================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_USE_TLS=true

# Supabase (optional)
SUPABASE_URL=
SUPABASE_KEY=

# LLM - Anthropic
ANTHROPIC_API_KEY=

# Voice Synthesis - ElevenLabs (optional)
ELEVENLABS_API_KEY=

# Vector Database - Pinecone (optional)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=presentations

# File Storage - AWS S3 (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# CORS - Add all frontend URLs
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8080,https://web-seven-swart-96tyghlog6.vercel.app

# GCP Deployment Configuration
GCP_PROJECT_ID=project-987f80c5-14e3-450d-9b0
GCP_REGION=asia-south1
GCP_CLOUD_RUN_SERVICE=presentation-api
GCP_SQL_INSTANCE=presentation-db
GCP_DB_NAME=presentation_saas
GCP_DB_USER=app_user
