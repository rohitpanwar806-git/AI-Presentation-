{
  "framework": null,
  "buildCommand": "echo 'Static files ready'",
  "outputDirectory": "frontend/web",
  "routes": [
    {
      "src": "/settings(?:/)?$",
      "dest": "/settings.html"
    },
    {
      "src": "/(.*\\.(?:js|css|ico|png|jpg|jpeg|svg|gif|woff2?|ttf|eot|map|json))$",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
